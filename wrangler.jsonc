// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// ⚠️ 本文件刻意不声明任何存储绑定（KV / D1 / DO）。
//
// 原因：一键部署（Deploy to Cloudflare）只读取仓库内的本文件来预配资源，
// 且不支持通过 URL 参数传入变量。若在此声明绑定，会导致：
//   1. 首次部署强制创建所有声明的资源（用户往往只需要其中一个）；
//   2. 二次部署时，源仓库中仍为空 id，与账户内已有的资源冲突，构建失败。
//
// 因此存储绑定请按需在 Cloudflare 控制台手动添加；部署成功后绑定即可，
// 前端初始化页的环境自检会校验存储是否就绪。
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URL / CF_* 等）请在
// .dev.vars.example 或 .env.example 中声明 —— 部署按钮据此生成输入项，
// 用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
// =============================================================================
{
  "name": "openlist-tsworkers",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // ===========================================================================
  // 普通环境变量（非敏感）
  // 注意：vars 会在每次 wrangler deploy 时被本文件覆盖（Secrets 不会）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // 数据存储格式：
    //   map（默认）- 整对象序列化为单个 JSON 键值，适合 KV/Blob
    //   key        - 分 key 存储，每实体一条记录（如 users_1）
    //   sql        - 关系表格式，与 Go 后端一致（适用于 D1/MySQL）
    "DB_FORMAT": "map",

    // 数据库驱动：
    //   auto（默认）- 自动检测，顺序 mysql → d1 → kv → blob → do → cfkv
    //   blob       - 腾讯云 EdgeOne Blob / 阿里云 ESA Blob
    //   cfkv       - Cloudflare KV REST API（需 CF_ACCOUNT / CF_KV_UUID / CF_API_KEY）
    //   kv         - Cloudflare KV binding（需下方 kv_namespaces）
    //   d1         - Cloudflare D1（需下方 d1_databases）
    //   do         - Cloudflare Durable Objects（需下方 durable_objects）
    //   mysql      - 外部 MySQL（需 MYSQL_URL 或 MYSQL_HOST 等，仅 Node 运行时）
    // 说明：mysql 仅在配置了连接信息时才参与 auto 探测，避免无谓的 TCP 建连。
    "DB_DRIVER": "auto"

    // ── 安全鉴权（推荐以 Secret 类型配置，见 .dev.vars.example）──────────
    //
    // JWT 签名密钥（>=16 字符，兼作字段加密与定时任务鉴权）
    // "JWT_SECRET": "",
    //
    // 跳过安装向导，自动以该密码初始化 admin
    // "ADMIN_PASS": "",
    //
    // CORS 白名单（逗号分隔，不设则仅同源）
    // "ALLOW_URLS": "https://yourdomain.com",

    // ── 可选参数 ──────────────────────────────────────────────────────────
    //
    // 单次整体上传（/put、/form）大小上限，单位字节。默认 26214400（25MB）
    // "MAX_UPLOAD": "26214400",
    //
    // 分片上传单片大小上限，单位字节。默认 16777216（16MB）
    // "MAX_UPPART": "16777216",
    //
    // 前端静态资源 CDN 地址，支持 $version 占位符
    // "ASSET_URLS": "https://example.com/dist",
    //
    // 允许作为种子数据来源的主机白名单，逗号/空格分隔
    // "ALLOW_SEED": "",

    // ── Cloudflare KV REST API（DB_DRIVER=cfkv 时三项需全部填写）───────────
    //
    // KV namespace ID
    // "CF_KV_UUID": "",
    //
    // 账户 ID
    // "CF_ACCOUNT": "",
    //
    // 具有 KV 读写权限的 API Token
    // "CF_API_KEY": "",

    // ── MySQL（DB_DRIVER=mysql 时，方式一 / 方式二 二选一）─────────────────
    //
    // 方式一：连接串
    // "MYSQL_URL": "mysql://user:pass@host:3306/db",
    //
    // 方式二：分项配置
    // "MYSQL_HOST": "127.0.0.1",
    // "MYSQL_PORT": "3306",
    // "MYSQL_USER": "root",
    // "MYSQL_PASS": "",
    // "MYSQL_NAME": "openlist",
  }

  // ===========================================================================
  // 存储绑定（按需在控制台添加其一；也可取消对应注释在仓库内声明）
  // ===========================================================================
  //
  // ▶ 方案 A：KV（推荐，免费额度大、最通用）
  //   控制台：Workers & Pages → KV → 创建命名空间 → 绑定到 Worker，变量名填 KV
  //   或取消以下注释（id 留空，首次部署由 Cloudflare 自动创建）：
  //
  // "kv_namespaces": [
  //   { "binding": "KV", "id": "" }
  // ],
  //
  // ▶ 方案 B：D1（关系型，可与 Go 后端共享库；DB_FORMAT 建议改为 "sql"）
  //   控制台：Workers & Pages → D1 → 创建数据库 → 绑定到 Worker，变量名填 DB
  //   省略 database_id 时，wrangler >= 4.45.0 会自动创建同名库并回写
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "openlist", "database_id": "" }
  // ],
  //
  // ▶ 方案 C：Durable Objects（内置 SQLite，强一致；DB_FORMAT 建议改为 "sql"）
  //   注意：DO 需要 migrations，且删除成本高，适合单租户部署。
  //
  // "durable_objects": {
  //   "bindings": [{ "name": "DO", "class_name": "OpenListDB" }]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["OpenListDB"] }
  // ],
  //
  // ▶ 方案 D：Blob / MySQL
  //   Blob 由 EdgeOne / ESA 自动注入，无需配置；
  //   MySQL 通过 Secret 配置 MYSQL_URL（或 MYSQL_HOST 等分项）。
}
