{
  "name": "@openlist-frontend/openlist-frontend",
  "version": "4.2.3",
  "type": "module",
  "author": {
    "name": "The OpenList Projects Contributors",
    "url": "https://github.com/OpenListTeam"
  },
  "description": "A new AList Fork to Anti Trust Crisis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenListTeam/OpenList-Frontend.git"
  },
  "bugs": {
    "url": "https://github.com/OpenListTeam/OpenList/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://openlist.team/",
  "scripts": {
    "crowdin:upload": "crowdin upload sources --auto-update",
    "crowdin:download": "crowdin download --verbose",
    "crowdin": "npm run crowdin:upload && npm run crowdin:download",
    "i18n:build": "npm run crowdin && node ./scripts/i18n.mjs",
    "i18n:release": "npm run crowdin:download && node ./scripts/i18n.mjs",
    "start": "tsx server.ts",
    "dev": "concurrently \"vite --port 3000 --host 0.0.0.0\" \"PORT=5244 tsx server.ts\"",
    "build": "vite build",
    "build:lite": "cross-env VITE_LITE=true vite build",
    "serve": "vite preview",
    "prepare": "husky",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\""
  },
  "license": "MIT",
  "devDependencies": {
    "@crowdin/cli": "^4.14.3",
    "@types/bencode": "^2.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/mark.js": "^8.11.12",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/sha256": "^0.2.2",
    "@types/streamsaver": "^2.0.5",
    "@vitejs/plugin-legacy": "^8.1.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "mermaid": "^11.16.0",
    "prettier": "3.8.4",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.1.0",
    "vite-plugin-dynamic-base": "^1.3.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "dependencies": {
    "@egjs/view360": "4.0.0-beta.7",
    "@embedpdf/snippet": "^2.14.4",
    "@hono/node-server": "^2.0.8",
    "@hope-ui/solid": "github:OpenListTeam/hope-ui#31b436e36ae5d266016814ba71a442ffa9d91181",
    "@jellyfin/libass-wasm": "^4.2.4",
    "@monaco-editor/loader": "1.7.0",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/keyboard": "^1.3.7",
    "@solid-primitives/storage": "^1.3.11",
    "@solidjs/router": "^0.9.1",
    "@stitches/core": "^1.2.8",
    "@types/ini": "^4.1.1",
    "@viselect/vanilla": "^3.9.0",
    "aplayer": "^1.10.1",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "asciinema-player": "^3.15.1",
    "axios": "^1.18.1",
    "bencode": "^4.0.0",
    "chardet": "^2.2.0",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "crypto-js": "^4.2.0",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.4.2",
    "ftp-srv": "^4.6.3",
    "handlebars": "^4.7.9",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.11.1",
    "hls.js": "^1.6.16",
    "hono": "^4.12.28",
    "ini": "^7.0.0",
    "katex": "^0.17.0",
