# local-only dev config (D1 backend testing; not for deployment)
wrangler.d1.toml

# OS files
Thumbs.db
desktop.ini

# test coverage
coverage/
.nyc_output/

# build output (keep in gitignore, should not commit)
pages/dist/
dist-server/
*.tsbuildinfo

# source maps (optional, can be removed)
*.map
*.js.map
*.css.map

# lock files (keep pnpm-lock.yaml only)
package-lock.json
yarn.lock

# misc
.cache/
.parcel-cache/
.turbo/

# cleanup scripts are tracked
!cleanup.bat
!cleanup.sh

# Security: Prevent sensitive files from being committed (Added: 2026-09-05)
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
**/.env
pages/.env
.env.production
.env.development
*.secret

# Security audit reports (contain sensitive information)
docs/3-Audit-Reports/
docs/*AUDIT*.md
docs/*SECURITY*.md
docs/TASK-COMPLETION-REPORT.md
