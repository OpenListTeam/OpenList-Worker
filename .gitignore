# runtime dir
node_modules
dist
dist-server
public_data

# temp file
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# ide files
.DS_Store
.idea
.test
.codebuddy
.vscode
.env
.env.local
.env.*.local
.wrangler
.reasonix

# build artifacts
*.tsbuildinfo
