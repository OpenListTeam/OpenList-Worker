diff --git a/src/pages/home/DriveClean.tsx b/src/pages/home/DriveClean.tsx
new file mode 100644
index 0000000..2d1937c
--- /dev/null
+++ b/src/pages/home/DriveClean.tsx
@@ -0,0 +1,314 @@
+import { Icon, Menu, MenuContent, MenuItem, MenuTrigger } from "@hope-ui/solid"
+import { For, Show, createEffect, createMemo, on } from "solid-js"
+import { useContextMenu } from "solid-contextmenu"
+import {
+  BsArrowUp,
+  BsFileEarmarkPlus,
+  BsFolderPlus,
+  BsPlusLg,
+  BsThreeDots,
+} from "solid-icons/bs"
+import { currentLang } from "~/app/i18n"
+import { useDownload, useRouter, useT } from "~/hooks"
+import {
+  State,
+  checkboxOpen,
+  getSettingBool,
+  haveSelected,
+  layout,
+  me,
+  objStore,
+  selectAll,
+  selectedObjs,
+  toggleCheckbox,
+  userCan,
+} from "~/store"
+import { UserMethods } from "~/types"
+import { bus, notify } from "~/utils"
+import { uploadStatus } from "~/utils/upload_status"
+import { DriveBrand } from "./DriveChrome"
+import { NavButton, DriveTree, useNavItems } from "./DrivePro"
+import { DriveUsage } from "./DriveUsage"
+import { TYPE_FILTERS, TypeFilter, countByType } from "./drive-clean-utils"
+import { setTypeFilter, typeFilter } from "./folder/type-filter"
+
+const zh = () => String(currentLang()).startsWith("zh")
+const text = (cn: string, en: string) => (zh() ? cn : en)
+
+/* ------------------------------------------------------------------ */
+/* Type filter: reset when the folder changes. */
+
+const FILTER_LABELS: Record<TypeFilter, [string, string]> = {
+  all: ["全部", "All"],
+  folder: ["文件夹", "Folders"],
+  video: ["视频", "Videos"],
+  image: ["图片", "Images"],
+  doc: ["文档", "Documents"],
+}
+
+const canWriteHere = (isShare: () => boolean) =>
+  objStore.state === State.Folder &&
+  !isShare() &&
+  (userCan("write_content") || objStore.write_content_bypass) &&
+  objStore.write
+
+export const DriveTypeFilter = () => {
+  const { pathname } = useRouter()
+  const counts = createMemo(() => countByType(objStore.objs))
+  // A paginated listing holds one page: say so instead of a wrong count.
+  const complete = () => objStore.objs.length >= objStore.total
+  createEffect(on(pathname, () => setTypeFilter("all"), { defer: true }))
+  const choose = (filter: TypeFilter) => {
+    if (filter === typeFilter()) return
+    // Hidden items must not stay selected behind the filter.
+    selectAll(false)
+    setTypeFilter(filter)
+  }
+  return (
+    <Show when={[State.Folder, State.FetchingMore].includes(objStore.state)}>
+      <div class="drive-filter-row">
+        <div
+          class="drive-filter-chips"
+          role="group"
+          aria-label={text("按类型筛选", "Filter by type")}
+        >
+          <For each={TYPE_FILTERS}>
+            {(filter) => (
+              <button
+                type="button"
+                class="drive-chip"
+                aria-pressed={typeFilter() === filter}
+                disabled={filter !== "all" && complete() && !counts()[filter]}
+                onClick={() => choose(filter)}
+              >
+                {text(...FILTER_LABELS[filter])}
+                <Show when={filter !== "all" && counts()[filter] > 0}>
+                  <span class="drive-chip-count">{counts()[filter]}</span>
+                </Show>
+              </button>
+            )}
+          </For>
+        </div>
+        <span class="drive-filter-total" role="status">
+          {typeFilter() === "all"
+            ? text(`${objStore.total} 项`, `${objStore.total} items`)
+            : text(
+                `显示 ${counts()[typeFilter()]} / ${objStore.total} 项`,
+                `${counts()[typeFilter()]} of ${objStore.total} items`,
+              )}
+        </span>
+      </div>
+    </Show>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Sidebar */
+
+const NewMenu = () => {
+  const t = useT()
+  const { isShare } = useRouter()
+  const canWrite = () => canWriteHere(isShare)
+  return (
+    <Menu placement="bottom-start">
+      <MenuTrigger
+        as="button"
+        class="drive-new-button"
+        disabled={!canWrite()}
+        title={
+          canWrite()
+            ? undefined
+            : text("打开一个可写入的文件夹后可新建", "Open a folder you can write to")
+        }
+      >
+        <Icon as={BsPlusLg} />
+        <span>{text("新建", "New")}</span>
+      </MenuTrigger>
+      <MenuContent>
+        <MenuItem onSelect={() => bus.emit("tool", "upload")}>
+          <Icon as={BsArrowUp} />
+          {t("home.toolbar.upload")}
+        </MenuItem>
+        <MenuItem onSelect={() => bus.emit("tool", "mkdir")}>
+          <Icon as={BsFolderPlus} />
+          {t("home.toolbar.mkdir")}
+        </MenuItem>
+        <MenuItem onSelect={() => bus.emit("tool", "new_file")}>
+          <Icon as={BsFileEarmarkPlus} />
+          {t("home.toolbar.new_file")}
+        </MenuItem>
+      </MenuContent>
+    </Menu>
+  )
+}
+
+const UploadCard = () => (
+  <Show when={uploadStatus().active > 0}>
+    <div class="drive-upload-card" role="status">
+      <div class="drive-upload-card-head">
+        <strong>
+          {text(
+            `正在上传 ${uploadStatus().active} 项`,
+            `Uploading ${uploadStatus().active} item${uploadStatus().active === 1 ? "" : "s"}`,
+          )}
+        </strong>
+        <button
+          type="button"
+          class="drive-link-button"
+          onClick={() => bus.emit("tool", "transfers")}
+        >
+          {text("查看", "View")}
+        </button>
+      </div>
+      <div class="drive-progress drive-upload-card-bar" aria-hidden="true">
+        <span style={{ width: `${uploadStatus().progress}%` }} />
+      </div>
+      <span class="drive-upload-card-name" title={uploadStatus().name}>
+        {uploadStatus().name} · {uploadStatus().progress}%
+      </span>
+    </div>
+  </Show>
+)
+
+export const DriveSidebar = () => {
+  const { items } = useNavItems()
+  const { isShare } = useRouter()
+  return (
+    <aside
+      id="drive-desktop-navigation"
+      class="drive-sidebar"
+      aria-label={text("侧栏", "Sidebar")}
+    >
+      <DriveBrand />
+      <Show when={!isShare()}>
+        <NewMenu />
+      </Show>
+      <nav class="drive-side-nav" aria-label={text("主导航", "Main")}>
+        <For each={items()}>
+          {(item) => <NavButton item={item} class="drive-side-item" />}
+        </For>
+      </nav>
+      <Show when={!isShare()}>
+        <div class="drive-side-section">
+          <p class="drive-side-label">{text("挂载", "Storage")}</p>
+          <DriveTree embedded />
+        </div>
+      </Show>
+      <div class="drive-side-end">
+        <UploadCard />
+        <DriveUsage />
+      </div>
+    </aside>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Floating bar for the selected items */
+
+export const DriveSelectionBar = () => {
+  const t = useT()
+  const { isShare } = useRouter()
+  const { batchDownloadSelected } = useDownload()
+  const { show } = useContextMenu({ id: 1 })
+  const shown = () =>
+    haveSelected() &&
+    [State.Folder, State.FetchingMore].includes(objStore.state)
+  // Same rules as the context menu.
+  const blocked = () => selectedObjs().some((obj) => !!(obj as any).migration)
+  const may = (name: "move" | "copy" | "delete") =>
+    userCan(name) && objStore.write && !isShare() && !blocked()
+  const download = () => {
+    if (selectedObjs().some((obj) => obj.is_dir)) {
+      if (!UserMethods.is_admin(me()) && !getSettingBool("package_download")) {
+        notify.warning(t("home.toolbar.package_download_disabled"))
+        return
+      }
+      bus.emit("tool", "package_download")
+      return
+    }
+    batchDownloadSelected()
+  }
+  const clear = () => {
+    selectAll(false)
+    if (layout() !== "list" && checkboxOpen()) toggleCheckbox()
+  }
+  return (
+    <Show when={shown()}>
+      <div
+        class="drive-selection-bar"
+        role="toolbar"
+        aria-label={text("已选项目操作", "Selected items")}
+        onKeyDown={(event: KeyboardEvent) => {
+          if (event.key === "Escape") clear()
+        }}
+      >
+        <span class="drive-selection-bar-count" role="status">
+          {text(
+            `已选 ${selectedObjs().length} 项`,
+            `${selectedObjs().length} selected`,
+          )}
+        </span>
+        <button type="button" onClick={download}>
+          {t("home.toolbar.download")}
+        </button>
+        <Show when={may("move")}>
+          <button type="button" onClick={() => bus.emit("tool", "move")}>
+            {t("home.toolbar.move")}
+          </button>
+        </Show>
+        <Show when={may("copy")}>
+          <button type="button" onClick={() => bus.emit("tool", "copy")}>
+            {t("home.toolbar.copy")}
+          </button>
+        </Show>
+        <Show when={userCan("share") && !isShare()}>
+          <button type="button" onClick={() => bus.emit("tool", "share")}>
+            {t("home.toolbar.share")}
+          </button>
+        </Show>
+        <Show when={may("delete")}>
+          <button
+            type="button"
+            class="drive-selection-bar-danger"
+            onClick={() => bus.emit("tool", "delete")}
+          >
+            {t("home.toolbar.delete")}
+          </button>
+        </Show>
+        <button
+          type="button"
+          class="drive-selection-bar-icon"
+          aria-label={t("home.toolbar.more")}
+          title={t("home.toolbar.more")}
+          onClick={(event) => {
+            event.preventDefault()
+            event.stopPropagation()
+            show(event, { props: selectedObjs()[0] })
+          }}
+        >
+          <Icon as={BsThreeDots} />
+        </button>
+        <button
+          type="button"
+          class="drive-selection-bar-icon drive-selection-bar-close"
+          aria-label={text("取消选择", "Clear selection")}
+          title={text("取消选择", "Clear selection")}
+          onClick={clear}
+        >
+          <svg
+            width="16"
+            height="16"
+            viewBox="0 0 24 24"
+            fill="none"
+            stroke="currentColor"
+            stroke-width="2"
+            stroke-linecap="round"
+            aria-hidden="true"
+          >
+            <path d="M6 6l12 12M18 6 6 18" />
+          </svg>
+        </button>
+      </div>
+    </Show>
+  )
+}
