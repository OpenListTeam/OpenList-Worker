+import { createSignal } from "solid-js"
+import { matchesType, type TypeFilter } from "../drive-clean-utils"
+
+// The type chips above the list; every layout (list, grid, photos) hides the
+// items the current chip leaves out.
+const [typeFilter, setTypeFilter] = createSignal<TypeFilter>("all")
+export { typeFilter, setTypeFilter }
+
+export const shownByType = (obj: {
+  name: string
+  is_dir: boolean
+  type: number
+}) => matchesType(obj, typeFilter())
