new file mode 100644
index 0000000..d111409
--- /dev/null
+++ b/src/pages/home/drive-clean-utils.ts
@@ -0,0 +1,71 @@
+/** Pure helpers for the clean workspace layout (unit-testable). */
+
+export type TypeFilter = "all" | "folder" | "video" | "image" | "doc"
+
+export const TYPE_FILTERS: TypeFilter[] = [
+  "all",
+  "folder",
+  "video",
+  "image",
+  "doc",
+]
+
+// ObjType from ~/types: 1 folder, 2 video, 3 audio, 4 text, 5 image.
+const DOC_EXTS = [
+  "pdf",
+  "doc",
+  "docx",
+  "xls",
+  "xlsx",
+  "ppt",
+  "pptx",
+  "odt",
+  "ods",
+  "odp",
+  "rtf",
+  "txt",
+  "md",
+  "csv",
+  "epub",
+]
+const IMAGE_EXTS = ["heic", "heif", "avif"]
+
+interface ObjLike {
+  name: string
+  is_dir: boolean
+  type: number
+}
+
+const ext = (name: string) => {
+  const dot = name.lastIndexOf(".")
+  return dot > 0 ? name.slice(dot + 1).toLowerCase() : ""
+}
+
+/** Which filter chip an item belongs to, if any besides "all". */
+export function kindOf(obj: ObjLike): Exclude<TypeFilter, "all"> | undefined {
+  if (obj.is_dir || obj.type === 1) return "folder"
+  if (obj.type === 2) return "video"
+  if (obj.type === 5 || IMAGE_EXTS.includes(ext(obj.name))) return "image"
+  if (obj.type === 4 || DOC_EXTS.includes(ext(obj.name))) return "doc"
+  return undefined
+}
+
+export function matchesType(obj: ObjLike, filter: TypeFilter) {
+  return filter === "all" || kindOf(obj) === filter
+}
+
+/** Count per chip, so empty chips can say so. */
+export function countByType(objs: ObjLike[]) {
+  const counts: Record<TypeFilter, number> = {
+    all: objs.length,
+    folder: 0,
+    video: 0,
+    image: 0,
+    doc: 0,
+  }
+  for (const obj of objs) {
+    const kind = kindOf(obj)
+    if (kind) counts[kind]++
+  }
+  return counts
+}
