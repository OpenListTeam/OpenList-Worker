@@ -0,0 +1,49 @@
+/** Pure helpers for the upload tray (no UI imports, unit-testable). */
+
+export type FileKind = "video" | "image" | "audio" | "archive" | "doc" | "file"
+
+const KINDS: Record<Exclude<FileKind, "file">, string[]> = {
+  video: ["mp4", "mkv", "mov", "avi", "webm", "m4v", "ts", "flv", "wmv", "rmvb"],
+  image: ["jpg", "jpeg", "png", "gif", "webp", "heic", "heif", "bmp", "svg", "avif", "tif", "tiff"],
+  audio: ["mp3", "flac", "wav", "aac", "m4a", "ogg", "opus", "ape"],
+  archive: ["zip", "rar", "7z", "tar", "gz", "tgz", "bz2", "xz", "iso"],
+  doc: ["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "md", "epub", "csv"],
+}
+
+export function fileKind(name: string): FileKind {
+  const dot = name.lastIndexOf(".")
+  if (dot <= 0) return "file"
+  const ext = name.slice(dot + 1).toLowerCase()
+  for (const [kind, list] of Object.entries(KINDS))
+    if (list.includes(ext)) return kind as FileKind
+  return "file"
+}
+
+interface TaskLike {
+  status: string
+  speed: number
+  directory: string
+}
+
+const DONE = ["success", "cancelled"]
+
+/** Finished tasks fold into a collapsed group; everything else stays listed. */
+export function splitTasks<T extends TaskLike>(tasks: T[]) {
+  return {
+    current: tasks.filter((task) => !DONE.includes(task.status)),
+    done: tasks.filter((task) => DONE.includes(task.status)),
+  }
+}
+
+export function totalSpeed(tasks: TaskLike[]) {
+  return tasks.reduce(
+    (sum, task) => sum + (task.status === "uploading" ? task.speed || 0 : 0),
+    0,
+  )
+}
+
+/** The one destination of the given tasks, or undefined when they differ. */
+export function commonDirectory(tasks: TaskLike[]) {
+  const dirs = new Set(tasks.map((task) => task.directory))
+  return dirs.size === 1 ? [...dirs][0] : undefined
+}
