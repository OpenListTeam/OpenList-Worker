+++ b/src/pages/home/drive-pro-utils.ts
@@ -0,0 +1,60 @@
+/** Pure helpers for the pro file-browser layout (kept free of UI imports). */
+
+/** "/a/b" -> ["/", "/a", "/a/b"] */
+export function ancestors(path: string): string[] {
+  const parts = path.split("/").filter(Boolean)
+  return ["/", ...parts.map((_, i) => "/" + parts.slice(0, i + 1).join("/"))]
+}
+
+export function childPath(parent: string, name: string): string {
+  return parent === "/" ? `/${name}` : `${parent}/${name}`
+}
+
+/** File type label shown in the details panel, e.g. "MKV". */
+export function typeLabel(name: string, isDir: boolean, zh: boolean): string {
+  if (isDir) return zh ? "文件夹" : "Folder"
+  const dot = name.lastIndexOf(".")
+  if (dot > 0 && dot < name.length - 1) return name.slice(dot + 1).toUpperCase()
+  return zh ? "文件" : "File"
+}
+
+export interface SizedItem {
+  is_dir: boolean
+  size: number
+}
+
+/** Folder/file counts and the total size of the files among `items`. */
+export function summarize(items: SizedItem[]) {
+  let folders = 0
+  let files = 0
+  let bytes = 0
+  for (const item of items) {
+    if (item.is_dir) folders++
+    else {
+      files++
+      bytes += Number(item.size) || 0
+    }
+  }
+  return { folders, files, bytes }
+}
+
+export const INSPECTOR_KEY = "drive_inspector"
+export const INSPECTOR_MIN_WIDTH = 1280
+
+/** Remembered choice wins; otherwise open on wide screens only. */
+export function initialInspectorOpen(
+  saved: string | null,
+  width: number,
+): boolean {
+  if (saved === "open") return true
+  if (saved === "closed") return false
+  return width >= INSPECTOR_MIN_WIDTH
+}
+
+/** "3 个文件夹 · 1 个文件" / "3 folders · 1 file" */
+export function countLabel(folders: number, files: number, zh: boolean) {
+  if (zh) return `${folders} 个文件夹 · ${files} 个文件`
+  const plural = (n: number, word: string) =>
+    `${n} ${word}${n === 1 ? "" : "s"}`
+  return `${plural(folders, "folder")} · ${plural(files, "file")}`
+}
