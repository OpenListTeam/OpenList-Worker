+++ b/src/pages/home/DrivePro.tsx
@@ -0,0 +1,675 @@
+import { Icon } from "@hope-ui/solid"
+import {
+  Accessor,
+  For,
+  Show,
+  createContext,
+  createEffect,
+  createMemo,
+  createSignal,
+  on,
+  useContext,
+} from "solid-js"
+import { createStore } from "solid-js/store"
+import {
+  BsClockHistory,
+  BsCloudUploadFill,
+  BsDownload,
+  BsFolder2,
+  BsGearFill,
+  BsInfoCircle,
+  BsLink45deg,
+  BsShare,
+} from "solid-icons/bs"
+import { currentLang } from "~/app/i18n"
+import { useLink, useRouter, useUtil } from "~/hooks"
+import {
+  State,
+  haveSelected,
+  me,
+  objStore,
+  password,
+  selectedObjs,
+  userCan,
+} from "~/store"
+import { StoreObj, UserMethods } from "~/types"
+import {
+  bus,
+  encodePath,
+  formatDate,
+  fsDirs,
+  getFileSize,
+  joinBase,
+} from "~/utils"
+import { getIconByObj } from "~/utils/icon"
+import { uploadStatus } from "~/utils/upload_status"
+import { DriveUsage } from "./DriveUsage"
+import { openItem } from "./folder/open-item"
+import {
+  INSPECTOR_KEY,
+  ancestors,
+  childPath,
+  countLabel,
+  initialInspectorOpen,
+  summarize,
+  typeLabel,
+} from "./drive-pro-utils"
+
+const zh = () => String(currentLang()).startsWith("zh")
+const text = (cn: string, en: string) => (zh() ? cn : en)
+const isFilesRoute = (path: string) => !["/@links", "/@recent"].includes(path)
+
+/* ------------------------------------------------------------------ */
+/* Details panel open/closed state, shared by the toggle and the shell. */
+
+export const InspectorContext = createContext<{
+  open: Accessor<boolean>
+  toggle: () => void
+}>()
+
+export const createInspectorState = () => {
+  let saved: string | null = null
+  try {
+    saved = localStorage.getItem(INSPECTOR_KEY)
+  } catch {}
+  const [open, setOpen] = createSignal(
+    initialInspectorOpen(saved, window.innerWidth),
+  )
+  const toggle = () => {
+    const next = !open()
+    setOpen(next)
+    try {
+      localStorage.setItem(INSPECTOR_KEY, next ? "open" : "closed")
+    } catch {}
+  }
+  return { open, toggle }
+}
+
+export const DriveInspectorToggle = () => {
+  const inspector = useContext(InspectorContext)
+  const label = () =>
+    inspector?.open()
+      ? text("隐藏详情", "Hide details")
+      : text("显示详情", "Show details")
+  return (
+    <Show when={inspector}>
+      <button
+        type="button"
+        class="drive-icon-button drive-inspector-toggle"
+        aria-label={label()}
+        title={label()}
+        aria-pressed={inspector!.open()}
+        aria-controls="drive-inspector"
+        onClick={inspector!.toggle}
+      >
+        <Icon as={BsInfoCircle} />
+      </button>
+    </Show>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Icon rail */
+
+const RailLink = (props: {
+  label: string
+  icon: any
+  current?: boolean
+  onClick: () => void
+}) => (
+  <button
+    type="button"
+    class="drive-icon-rail-item"
+    classList={{ "drive-icon-rail-current": !!props.current }}
+    aria-current={props.current ? "page" : undefined}
+    onClick={props.onClick}
+  >
+    <Icon as={props.icon} />
+    <span>{props.label}</span>
+  </button>
+)
+
+export const DriveIconRail = () => {
+  const { to, isShare, pathname } = useRouter()
+  const signedIn = () => !!me().id && !UserMethods.is_guest(me())
+  const canUpload = () =>
+    objStore.state === State.Folder &&
+    !isShare() &&
+    (userCan("write_content") || objStore.write_content_bypass) &&
+    objStore.write
+  return (
+    <nav class="drive-icon-rail" aria-label={text("主导航", "Main")}>
+      <button
+        type="button"
+        class="drive-icon-rail-brand"
+        aria-label={text("返回首页", "Go home")}
+        onClick={() => to("/")}
+      >
+        O
+      </button>
+      <Show when={!isShare()}>
+        <RailLink
+          label={text("文件", "Files")}
+          icon={BsFolder2}
+          current={isFilesRoute(pathname())}
+          onClick={() => to("/")}
+        />
+      </Show>
+      <Show when={!isShare() && signedIn()}>
+        <RailLink
+          label={text("最近", "Recent")}
+          icon={BsClockHistory}
+          current={pathname() === "/@recent"}
+          onClick={() => to("/@recent")}
+        />
+      </Show>
+      <Show when={!isShare() && UserMethods.is_admin(me())}>
+        <RailLink
+          label={text("分享", "Shared")}
+          icon={BsShare}
+          current={pathname() === "/@links"}
+          onClick={() => to("/@links")}
+        />
+      </Show>
+      <Show when={canUpload()}>
+        <RailLink
+          label={text("传输", "Transfers")}
+          icon={BsCloudUploadFill}
+          onClick={() => bus.emit("tool", "upload")}
+        />
+      </Show>
+      <Show when={signedIn()}>
+        <div class="drive-icon-rail-end">
+          <RailLink
+            label={text("管理", "Manage")}
+            icon={BsGearFill}
+            onClick={() => to("/@manage")}
+          />
+        </div>
+      </Show>
+    </nav>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Folder tree */
+
+type TreeNode = { path: string; name: string }
+
+const Chevron = (props: { open: boolean }) => (
+  <svg
+    width="12"
+    height="12"
+    viewBox="0 0 24 24"
+    fill="none"
+    stroke="currentColor"
+    stroke-width="2.4"
+    stroke-linecap="round"
+    stroke-linejoin="round"
+    aria-hidden="true"
+    style={{ transform: props.open ? "rotate(90deg)" : undefined }}
+  >
+    <path d="m9 6 6 6-6 6" />
+  </svg>
+)
+
+export const DriveTree = () => {
+  const { pathname, to, isShare } = useRouter()
+  const [children, setChildren] = createStore<
+    Record<string, TreeNode[] | undefined>
+  >({})
+  const [expanded, setExpanded] = createStore<Record<string, boolean>>({})
+  const loading = new Set<string>()
+
+  const load = async (path: string) => {
+    if (children[path] || loading.has(path)) return
+    loading.add(path)
+    try {
+      const resp: any = await fsDirs(path, password())
+      const list: any[] =
+        resp?.code === 200 && Array.isArray(resp.data) ? resp.data : []
+      setChildren(
+        path,
+        list.map((obj) => ({
+          path: childPath(path, obj.name),
+          name: obj.name,
+        })),
+      )
+    } catch {
+      setChildren(path, [])
+    } finally {
+      loading.delete(path)
+    }
+  }
+
+  // Reveal the current folder: expand and load every ancestor.
+  createEffect(
+    on(pathname, (current) => {
+      if (isShare() || !isFilesRoute(current)) return
+      for (const path of ancestors(current)) {
+        setExpanded(path, true)
+        void load(path)
+      }
+    }),
+  )
+
+  // The open listing is the freshest view of the current folder's children.
+  createEffect(() => {
+    if (objStore.state !== State.Folder || isShare()) return
+    const current = pathname()
+    setChildren(
+      current,
+      objStore.objs
+        .filter((obj) => obj.is_dir)
+        .map((obj) => ({ path: childPath(current, obj.name), name: obj.name })),
+    )
+  })
+
+  const migration = (path: string) => {
+    const current = pathname()
+    const obj = objStore.objs.find(
+      (item) => childPath(current, item.name) === path,
+    ) as any
+    return obj?.migration as
+      { processed: number; discovered: number; state: string } | undefined
+  }
+
+  const Branch = (props: { path: string; depth: number }) => (
+    <For each={children[props.path] ?? []}>
+      {(node) => {
+        const open = () => !!expanded[node.path]
+        const current = () => pathname() === node.path
+        const job = () => migration(node.path)
+        return (
+          <li role="treeitem" aria-expanded={open()}>
+            <div
+              class="drive-tree-row"
+              classList={{ "drive-tree-current": current() }}
+              style={{ "padding-left": `${8 + props.depth * 16}px` }}
+            >
+              <button
+                type="button"
+                class="drive-tree-twisty"
+                aria-label={
+                  open()
+                    ? text(`收起 ${node.name}`, `Collapse ${node.name}`)
+                    : text(`展开 ${node.name}`, `Expand ${node.name}`)
+                }
+                onClick={() => {
+                  setExpanded(node.path, !open())
+                  if (!open()) return
+                  void load(node.path)
+                }}
+              >
+                <Chevron open={open()} />
+              </button>
+              <a
+                class="drive-tree-link"
+                href={joinBase(encodePath(node.path))}
+                aria-current={current() ? "page" : undefined}
+                onClick={(event: MouseEvent) => {
+                  if (event.ctrlKey || event.metaKey || event.shiftKey) return
+                  event.preventDefault()
+                  to(encodePath(node.path))
+                }}
+              >
+                {node.name}
+              </a>
+              <Show when={job()}>
+                <span
+                  class="drive-tree-job"
+                  title={text("B2 同步中", "B2 syncing")}
+                >
+                  {job()!.processed}/{job()!.discovered}
+                </span>
+              </Show>
+            </div>
+            <Show when={open() && (children[node.path]?.length ?? 0) > 0}>
+              <ul role="group" class="drive-tree-list">
+                <Branch path={node.path} depth={props.depth + 1} />
+              </ul>
+            </Show>
+          </li>
+        )
+      }}
+    </For>
+  )
+
+  return (
+    <aside
+      id="drive-desktop-navigation"
+      class="drive-tree"
+      aria-label={text("目录", "Folders")}
+    >
+      <Show when={!isShare()}>
+        <a
+          class="drive-tree-root"
+          classList={{ "drive-tree-current": pathname() === "/" }}
+          href={joinBase("/")}
+          aria-current={pathname() === "/" ? "page" : undefined}
+          onClick={(event: MouseEvent) => {
+            if (event.ctrlKey || event.metaKey || event.shiftKey) return
+            event.preventDefault()
+            to("/")
+          }}
+        >
+          {text("所有文件", "All files")}
+        </a>
+        <ul
+          role="tree"
+          class="drive-tree-list"
+          aria-label={text("目录树", "Folder tree")}
+        >
+          <Branch path="/" depth={0} />
+        </ul>
+      </Show>
+      <div class="drive-tree-footer">
+        <DriveUsage />
+      </div>
+    </aside>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Details panel */
+
+const Meta = (props: { label: string; value: string; mono?: boolean }) => (
+  <>
+    <dt>{props.label}</dt>
+    <dd classList={{ "drive-mono": !!props.mono }}>{props.value}</dd>
+  </>
+)
+
+const ItemDetails = (props: { obj: StoreObj }) => {
+  const { rawLink } = useLink()
+  const { copy } = useUtil()
+  const { pathname, pushHref, to, isShare } = useRouter()
+  const link = () => (props.obj.is_dir ? "" : rawLink(props.obj, true))
+  const job = () => (props.obj as any).migration
+  return (
+    <>
+      <div class="drive-inspector-preview">
+        <Show
+          when={props.obj.thumb}
+          fallback={<Icon as={getIconByObj(props.obj)} boxSize="$16" />}
+        >
+          <img src={props.obj.thumb} alt="" loading="lazy" />
+        </Show>
+      </div>
+      <div class="drive-inspector-title">
+        <h2>{props.obj.name}</h2>
+        <span>{typeLabel(props.obj.name, props.obj.is_dir, zh())}</span>
+      </div>
+      <div class="drive-inspector-actions">
+        <button
+          type="button"
+          class="drive-button drive-button-primary"
+          onClick={() => openItem(props.obj, pushHref(props.obj.name), to)}
+        >
+          {text("打开", "Open")}
+        </button>
+        <Show when={!props.obj.is_dir}>
+          <a class="drive-button" href={link()} download={props.obj.name}>
+            <Icon as={BsDownload} />
+            {text("下载", "Download")}
+          </a>
+        </Show>
+        <Show when={userCan("share") && !isShare()}>
+          <button
+            type="button"
+            class="drive-button"
+            onClick={() => bus.emit("tool", "share")}
+          >
+            <Icon as={BsShare} />
+            {text("分享", "Share")}
+          </button>
+        </Show>
+      </div>
+      <dl class="drive-inspector-meta">
+        <Show when={!props.obj.is_dir}>
+          <Meta
+            label={text("大小", "Size")}
+            value={getFileSize(props.obj.size)}
+            mono
+          />
+        </Show>
+        <Meta
+          label={text("修改时间", "Modified")}
+          value={formatDate(props.obj.modified)}
+          mono
+        />
+        <Meta label={text("位置", "Location")} value={pathname()} mono />
+        <Show when={objStore.provider}>
+          <Meta label={text("存储", "Storage")} value={objStore.provider} />
+        </Show>
+      </dl>
+      <Show when={link()}>
+        <div class="drive-inspector-link">
+          <label for="drive-inspector-raw">{text("直链", "Direct link")}</label>
+          <div>
+            <input id="drive-inspector-raw" readonly value={link()} />
+            <button
+              type="button"
+              class="drive-button"
+              aria-label={text("复制直链", "Copy direct link")}
+              onClick={() => copy(link())}
+            >
+              <Icon as={BsLink45deg} />
+              {text("复制", "Copy")}
+            </button>
+          </div>
+        </div>
+      </Show>
+      <Show when={job()}>
+        <div class="drive-inspector-job" role="status">
+          <strong>
+            {job().state === "paused"
+              ? text("B2 同步已暂停", "B2 sync paused")
+              : text("B2 同步中", "B2 syncing")}
+          </strong>
+          <div class="drive-progress">
+            <span
+              style={{
+                width: `${job().discovered ? Math.round((job().processed / job().discovered) * 100) : 0}%`,
+              }}
+            />
+          </div>
+          <span>
+            {text(
+              `${job().processed} / ${job().discovered} 个文件 · 完成前该目录暂不可写入`,
+              `${job().processed} / ${job().discovered} files · writes are paused until it finishes`,
+            )}
+          </span>
+        </div>
+      </Show>
+    </>
+  )
+}
+
+const FolderDetails = () => {
+  const { pathname } = useRouter()
+  const totals = createMemo(() => summarize(objStore.objs))
+  const name = () => pathname().split("/").filter(Boolean).pop()
+  return (
+    <>
+      <div class="drive-inspector-preview">
+        <Icon as={BsFolder2} boxSize="$16" />
+      </div>
+      <div class="drive-inspector-title">
+        {/* The folder name is already the page heading; don't repeat it. */}
+        <p class="drive-inspector-name">
+          {name() || text("所有文件", "All files")}
+        </p>
+        <span>{text("当前文件夹", "Current folder")}</span>
+      </div>
+      <dl class="drive-inspector-meta">
+        <Meta
+          label={text("内容", "Contents")}
+          value={countLabel(totals().folders, totals().files, zh())}
+        />
+        <Show when={totals().files > 0}>
+          <Meta
+            label={text("文件大小", "Files size")}
+            value={getFileSize(totals().bytes)}
+            mono
+          />
+        </Show>
+        <Meta label={text("位置", "Location")} value={pathname()} mono />
+        <Show when={objStore.provider}>
+          <Meta label={text("存储", "Storage")} value={objStore.provider} />
+        </Show>
+      </dl>
+      <p class="drive-inspector-hint">
+        {text(
+          "选择一个文件即可查看详情和直链。",
+          "Select a file to see its details and direct link.",
+        )}
+      </p>
+    </>
+  )
+}
+
+const SelectionDetails = () => {
+  const totals = createMemo(() => summarize(selectedObjs()))
+  const { copy } = useUtil()
+  const { rawLink } = useLink()
+  const links = () =>
+    selectedObjs()
+      .filter((obj) => !obj.is_dir)
+      .map((obj) => rawLink(obj, true))
+      .join("\n")
+  return (
+    <>
+      <div class="drive-inspector-title">
+        <h2>
+          {text(
+            `已选 ${selectedObjs().length} 项`,
+            `${selectedObjs().length} selected`,
+          )}
+        </h2>
+        <span>{countLabel(totals().folders, totals().files, zh())}</span>
+      </div>
+      <dl class="drive-inspector-meta">
+        <Meta
+          label={text("文件大小", "Files size")}
+          value={getFileSize(totals().bytes)}
+          mono
+        />
+      </dl>
+      <Show when={totals().files > 0}>
+        <div class="drive-inspector-actions">
+          <button
+            type="button"
+            class="drive-button"
+            onClick={() => copy(links())}
+          >
+            <Icon as={BsLink45deg} />
+            {text("复制全部直链", "Copy all direct links")}
+          </button>
+        </div>
+      </Show>
+    </>
+  )
+}
+
+export const DriveInspector = () => {
+  const inspector = useContext(InspectorContext)!
+  const one = () =>
+    selectedObjs().length === 1 ? selectedObjs()[0] : undefined
+  return (
+    <aside
+      id="drive-inspector"
+      class="drive-inspector"
+      aria-label={text("详情", "Details")}
+      hidden={!inspector.open()}
+    >
+      <div class="drive-inspector-head">
+        <span>{text("详情", "Details")}</span>
+        <button
+          type="button"
+          class="drive-icon-button"
+          aria-label={text("关闭详情", "Close details")}
+          onClick={inspector.toggle}
+        >
+          <svg
+            width="16"
+            height="16"
+            viewBox="0 0 24 24"
+            fill="none"
+            stroke="currentColor"
+            stroke-width="2"
+            stroke-linecap="round"
+            aria-hidden="true"
+          >
+            <path d="M6 6l12 12M18 6 6 18" />
+          </svg>
+        </button>
+      </div>
+      <Show when={[State.Folder, State.FetchingMore].includes(objStore.state)}>
+        <Show
+          when={one()}
+          keyed
+          fallback={
+            <Show when={haveSelected()} fallback={<FolderDetails />}>
+              <SelectionDetails />
+            </Show>
+          }
+        >
+          {(obj) => <ItemDetails obj={obj} />}
+        </Show>
+      </Show>
+    </aside>
+  )
+}
+
+/* ------------------------------------------------------------------ */
+/* Status bar */
+
+export const DriveStatusBar = () => {
+  const selectedTotals = createMemo(() => summarize(selectedObjs()))
+  return (
+    <Show when={[State.Folder, State.FetchingMore].includes(objStore.state)}>
+      <footer class="drive-status-bar" role="status">
+        <span>{text(`${objStore.total} 项`, `${objStore.total} items`)}</span>
+        <Show when={haveSelected()}>
+          <span>
+            {text(
+              `已选 ${selectedObjs().length} 项`,
+              `${selectedObjs().length} selected`,
+            )}
+            <Show when={selectedTotals().files > 0}>
+              {" · "}
+              <span class="drive-mono">
+                {getFileSize(selectedTotals().bytes)}
+              </span>
+            </Show>
+          </span>
+        </Show>
+        <Show when={uploadStatus().active > 0}>
+          <button
+            type="button"
+            class="drive-status-upload"
+            onClick={() => bus.emit("tool", "upload")}
+          >
+            <span class="drive-status-upload-name">
+              {text(
+                `上传 ${uploadStatus().name}`,
+                `Uploading ${uploadStatus().name}`,
+              )}
+              <Show when={uploadStatus().active > 1}>
+                {text(
+                  ` 等 ${uploadStatus().active} 项`,
+                  ` +${uploadStatus().active - 1}`,
+                )}
+              </Show>
+            </span>
+            <span class="drive-progress" aria-hidden="true">
+              <span style={{ width: `${uploadStatus().progress}%` }} />
+            </span>
+            <span class="drive-mono">{uploadStatus().progress}%</span>
+          </button>
+        </Show>
+      </footer>
+    </Show>
+  )
+}
