diff --git a/src/utils/upload_status.ts b/src/utils/upload_status.ts
new file mode 100644
index 0000000..6b2d951
--- /dev/null
+++ b/src/utils/upload_status.ts
@@ -0,0 +1,45 @@
+import { createSignal } from "solid-js"
+
+export interface UploadStatus {
+  /** Tasks that still need work (not finished, cancelled or failed). */
+  active: number
+  /** The task currently transferring, or the next one waiting. */
+  name: string
+  /** Size-weighted progress of the active tasks, 0–100. */
+  progress: number
+}
+
+interface TaskLike {
+  name: string
+  size: number
+  progress: number
+  status: string
+}
+
+const DONE = ["success", "cancelled", "error"]
+const BUSY = ["uploading", "backending", "hashing", "verifying"]
+
+export function summarizeUploads(tasks: TaskLike[]): UploadStatus {
+  const active = tasks.filter((task) => !DONE.includes(task.status))
+  if (!active.length) return { active: 0, name: "", progress: 0 }
+  const current = active.find((task) => BUSY.includes(task.status)) ?? active[0]
+  const total = active.reduce((sum, task) => sum + (task.size || 0), 0)
+  const done = active.reduce(
+    (sum, task) => sum + ((task.size || 0) * (task.progress || 0)) / 100,
+    0,
+  )
+  const progress = total
+    ? Math.min(100, Math.round((done / total) * 100))
+    : Math.round(
+        active.reduce((sum, task) => sum + (task.progress || 0), 0) /
+          active.length,
+      )
+  return { active: active.length, name: current.name, progress }
+}
+
+const [uploadStatus, setUploadStatus] = createSignal<UploadStatus>({
+  active: 0,
+  name: "",
+  progress: 0,
+})
+export { uploadStatus, setUploadStatus }
