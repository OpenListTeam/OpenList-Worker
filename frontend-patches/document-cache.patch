+import { me, objStore } from "~/store"
+import { documentIdentity } from "~/utils/document-identity"
+import { useRouter } from "./useRouter"
+
+/** The cache identity of the file being previewed (see documentIdentity). */
+export const useDocumentIdentity = () => {
+  const { pathname } = useRouter()
+  return () => documentIdentity(me().id, pathname(), objStore.obj)
+}
