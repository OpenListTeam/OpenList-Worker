@@ -0,0 +1,40 @@
+import { createSignal } from "solid-js"
+import type { ViewerItem } from "./viewer-utils"
+
+// Set when a file is opened from a page of this app, so closing the viewer can
+// step back in history instead of pushing the folder again.
+export interface ViewerOrigin {
+  url: string
+  folder?: string
+  items?: ViewerItem[]
+  scroll: number
+}
+
+const [origin, setOrigin] = createSignal<ViewerOrigin>()
+export { origin as viewerOrigin }
+
+const scroller = () => document.querySelector<HTMLElement>(".drive-main")
+
+export function rememberViewerOrigin(
+  folder?: string,
+  items?: { name: string; is_dir: boolean }[],
+) {
+  setOrigin({
+    url: location.pathname + location.search,
+    folder,
+    items: items?.map((item) => ({ name: item.name, is_dir: item.is_dir })),
+    scroll: scroller()?.scrollTop || window.scrollY,
+  })
+}
+
+export function clearViewerOrigin() {
+  setOrigin(undefined)
+}
+
+export function restoreScroll(top: number) {
+  requestAnimationFrame(() => {
+    const el = scroller()
+    if (el && el.scrollHeight > el.clientHeight) el.scrollTop = top
+    else window.scrollTo(0, top)
+  })
+}
diff --git a/src/pages/home/file/viewer-utils.ts b/src/pages/home/file/viewer-utils.ts
new file mode 100644
index 0000000..b44970b
--- /dev/null
+++ b/src/pages/home/file/viewer-utils.ts
@@ -0,0 +1,57 @@
+/** Pure helpers for the file viewer (no UI imports, unit-testable). */
+
+export interface ViewerItem {
+  name: string
+  is_dir: boolean
+}
+
+/** The files around `current` in a listing; folders are skipped. */
+export function neighbours(items: ViewerItem[], current: string) {
+  const files = items.filter((item) => !item.is_dir).map((item) => item.name)
+  const index = files.indexOf(current)
+  if (index < 0) return { index: -1, total: files.length }
+  return {
+    index,
+    total: files.length,
+    prev: index > 0 ? files[index - 1] : undefined,
+    next: index < files.length - 1 ? files[index + 1] : undefined,
+  }
+}
+
+/** The folder that holds `path`, or undefined at the root of a share link. */
+export function parentFolder(path: string) {
+  const trimmed = path.replace(/\/+$/, "")
+  const cut = trimmed.lastIndexOf("/")
+  const parent = cut <= 0 ? "/" : trimmed.slice(0, cut)
+  if (parent === "/@s" || parent === "/%40s") return undefined
+  return parent
+}
+
+/** Keys the viewer acts on, unless typing or an embedded player owns them. */
+export function viewerKey(event: {
+  key: string
+  defaultPrevented?: boolean
+  altKey?: boolean
+  ctrlKey?: boolean
+  metaKey?: boolean
+  target?: unknown
+}): "prev" | "next" | "close" | undefined {
+  if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey)
+    return undefined
+  const target = event.target as
+    | { tagName?: string; isContentEditable?: boolean }
+    | null
+    | undefined
+  const tag = target?.tagName?.toLowerCase()
+  if (
+    tag === "input" ||
+    tag === "textarea" ||
+    tag === "select" ||
+    target?.isContentEditable
+  )
+    return undefined
+  if (event.key === "ArrowLeft") return "prev"
+  if (event.key === "ArrowRight") return "next"
+  if (event.key === "Escape") return "close"
+  return undefined
+}
