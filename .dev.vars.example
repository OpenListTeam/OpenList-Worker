# =============================================================================
# OpenList-TSWorker · 需要配置的 Secret（模板）
# =============================================================================
#
# 用途：Cloudflare「Deploy to Cloudflare」按钮会读取本文件，识别出部署时需要
#       用户填写的 Secret，并在部署页生成对应的输入项。用户填入真实值后，
#       Cloudflare 会把它保存为该 Worker 的 Secret（加密环境变量）。
#
# 为什么值留空：本文件会提交到公开仓库，绝不能包含真实密钥。
# 更新 Worker 时：Secrets 不会被 wrangler deploy 覆盖或删除，
#                 只有显式执行 `wrangler secret delete <name>` 才会移除。
#
# 本地开发：复制为 `.dev.vars`（已被 .gitignore 忽略）并填入真实值。
#
# 完整变量说明见：
#   https://doc.oplist.org/ecosystem/official_worker/guide_env
# =============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# JWT 签名密钥，同时用于字段加密（网盘凭据、2FA 密钥）与定时任务鉴权。
# 要求 >=16 字符；推荐用 `openssl rand -hex 32` 生成。
JWT_SECRET=

# ── 选填 ────────────────────────────────────────────────────────────────────

# 跳过安装向导，直接用此密码初始化 admin 账号。留空则由浏览器向导设置。
ADMIN_PASS=

# CORS 允许来源白名单，逗号分隔，如 https://yourdomain.com,https://www.yourdomain.com
# 留空表示仅允许同源请求。
ALLOW_URLS=

# MySQL 连接串（DB_DRIVER=mysql 时必填），如 mysql://user:pass@host:3306/db
# 也可改用 wrangler.jsonc 中注释的 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASS / MYSQL_NAME 分项。
MYSQL_URL=

# Cloudflare KV REST API 凭据（DB_DRIVER=cfkv 时三项均必填）。
# 账户 ID
CF_ACCOUNT=
# KV namespace ID
CF_KV_UUID=
# 具有 KV 读写权限的 API Token
CF_API_KEY=
