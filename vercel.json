{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/d/(.*)",
      "destination": "/api/d/$1"
    },
    {
      "source": "/sd/(.*)",
      "destination": "/api/sd/$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/p/$1"
    },
    {
      "source": "/((?!api/|d/|sd/|p/).*)",
      "destination": "/index.html"
    }
  ]
}
