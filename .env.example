# OpenList-TSWorker 环境变量配置示例
# 请复制此文件为 .env 并填写实际值

# ============================================
# 🔒 安全配置 (生产环境必须)
# ============================================

# JWT 签名密钥 (最小 32 字符，使用: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_min_32_characters

# 数据加密密钥 (最小 32 字符，与 JWT_SECRET 不同)
ENCRYPTION_SECRET=your_encryption_secret_here_min_32_characters

# 环境标识
NODE_ENV=development

# ============================================
# 📦 存储配置
# ============================================

# 数据存储模式: kv | d1 | mysql | blob | none
STORAGE_MODE=kv

# KV 命名空间绑定名称 (Cloudflare Workers KV)
KV_NAMESPACE=OPENLIST_KV

# D1 数据库绑定名称 (Cloudflare D1)
D1_BINDING=OPENLIST_DB

# MySQL 连接信息 (如果使用 MySQL)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=openlist

# Blob 存储绑定 (Cloudflare R2)
# BLOB_BINDING=OPENLIST_BLOB

# ============================================
# 🛡️ 安全策略
# ============================================

# 登录失败锁定阈值 (IP 维度)
LOGIN_MAX_FAILURES=5

# 登录失败锁定阈值 (全局用户名维度)
LOGIN_MAX_FAILURES_GLOBAL=20

# 登录锁定时长 (毫秒)
LOGIN_LOCK_MS=900000

# 最大锁定时长 (毫秒，指数退避最大值)
LOGIN_MAX_LOCK_MS=86400000

# IP 限流 (每分钟请求数)
IP_RATE_LIMIT=60

# ============================================
# 📁 文件上传
# ============================================

# 最大上传文件大小 (字节)
MAX_UPLOAD_SIZE=26214400

# 允许的文件类型 (逗号分隔)
# ALLOWED_FILE_TYPES=jpg,png,pdf,doc,docx

# ============================================
# 🔐 SSO / LDAP (可选)
# ============================================

# SSO 配置
# SSO_CLIENT_ID=your_sso_client_id
# SSO_CLIENT_SECRET=your_sso_client_secret
# SSO_LOGIN_URL=https://sso.example.com/login
# SSO_CALLBACK_URL=https://your-app.com/api/auth/sso/callback

# LDAP 配置
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=your_ldap_password
# LDAP_SEARCH_BASE=ou=users,dc=example,dc=com

# ============================================
# 🤖 定时任务
# ============================================

# CRON 任务密钥 (用于验证定时任务请求)
# CRON_SECRET=your_cron_secret_here

# ============================================
# 🔧 调试和监控
# ============================================

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 启用审计日志
AUDIT_LOG_ENABLED=true

# Sentry DSN (错误追踪)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# 📧 邮件通知 (可选)
# ============================================

# SMTP 配置
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@example.com

# ============================================
# 🌐 CORS 配置
# ============================================

# 允许的来源 (逗号分隔，* 表示所有来源 - 生产环境不推荐)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# 💡 开发环境专用
# ============================================

# 开发服务器端口
# PORT=8787

# 热重载
# HOT_RELOAD=true

# 详细日志
# VERBOSE=true

# CDN URL for frontend static assets (Optional).
# When set, static assets (assets/, images/, etc.) will be loaded from this CDN.
# Supports $version placeholder which will be replaced with the frontend version.
# Example: https://registry.npmmirror.com/@openlist-frontend/openlist-frontend/$version/files/dist
CDN_URL=
