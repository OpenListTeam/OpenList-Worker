# Base API endpoint for the front-end (usually /api)
VITE_API_URL=/api

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Serverless Database configuration (Optional: Custom JSON data structure to override default state)
DATABASE_JSON=

# Scheduled-task shared secret (Optional).
# EdgeOne Schedules cannot attach Authorization headers; when CRON_SECRET is set,
# POST /api/task/refresh accepts the matching value via query (?cron_secret=),
# JSON body {"cron_secret": ...} or the X-Cron-Secret header.
CRON_SECRET=
