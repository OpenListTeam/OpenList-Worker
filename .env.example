# ============================================================
# OpenList-TSWorker 环境变量示例
# 复制为 .env 后按需填写；仅列出代码实际读取的变量
# ============================================================

# ============================================================
# 安全鉴权
# ============================================================
# JWT签名密钥（>=16字符，兼作字段加密与定时任务鉴权）
JWT_SECRET=your_jwt_secret_here_min_32_characters

# 跳过安装向导，自动以该密码初始化admin（可选）
# ADMIN_PASS=

# CORS白名单（逗号分隔，不设则仅同源）
# ALLOW_URLS=https://yourdomain.com

# ============================================================
# 数据存储
# ============================================================
# 存储格式：map（默认）| key | sql
DB_FORMAT=map

# 数据库驱动：auto（默认）| blob | cfkv | kv | d1 | do | mysql
DB_DRIVER=auto

# ============================================================
# Cloudflare KV API（DB_DRIVER=cfkv 时三项必填）
# ============================================================
# CF_ACCOUNT=
# CF_KV_UUID=
# CF_API_KEY=

# ============================================================
# MySQL（DB_DRIVER=mysql 时，二选一）
# ============================================================
# 方式一：连接串
# MYSQL_URL=mysql://user:pass@host:3306/db
# 方式二：分项配置
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=
# MYSQL_NAME=openlist

# ============================================================
# 可选参数
# ============================================================
# 单次整体上传上限（字节），默认26214400
# MAX_UPLOAD=26214400

# 分片单片上传上限（字节），默认16777216
# MAX_UPPART=16777216

# 前端静态资源CDN地址，支持$version占位符
# ASSET_URLS=https://registry.npmmirror.com/@openlist-frontend/openlist-frontend/$version/files/dist

# 种子数据来源主机白名单（逗号/空格分隔）
# ALLOW_SEED=
