# =============================================================================
# OpenList-TSWorker · 环境变量（模板）
# =============================================================================
#
# 用途：Cloudflare「Deploy to Cloudflare」按钮会读取本文件（或 .dev.vars.example）
#       识别需要用户填写的变量，并在部署页生成对应输入项。
#
# 为什么值留空：本文件会提交到公开仓库，绝不能包含真实密钥。
#   部署时用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
#
# 本地开发：复制为 `.env`（已被 .gitignore 忽略）并填入真实值。
#
# 完整变量说明见：
#   https://doc.oplist.org/ecosystem/official_worker/guide_env
# =============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# JWT 签名密钥，同时用于字段加密（网盘凭据、2FA 密钥）与定时任务鉴权。
# 要求 >=16 字符；推荐用 `openssl rand -hex 32` 生成。
JWT_SECRET=

# ── 选填 ────────────────────────────────────────────────────────────────────

# 跳过安装向导，直接用此密码初始化 admin 账号。留空则由浏览器向导设置。
ADMIN_PASS=

# CORS 允许来源白名单，逗号分隔，如 https://yourdomain.com
# 留空表示仅允许同源请求。
ALLOW_URLS=

# 前端静态资源 CDN 地址（可选）。需指向包含完整前端 dist 的目录（含 index.html）。
# 配置后 Worker 从该 CDN 拉取 index.html 并注入 cdn，浏览器直连 CDN 加载 JS/CSS，
# 使 HTML 与哈希资产同源一致（避免本地 HTML 引用 CDN 上不存在的哈希导致批量 404）；
# CDN 不可达或返回非 HTML 时自动回退源站加载，不影响站点可用性。
# 支持 $version 占位符，替换为本构建的前端版本号（构建期写入，解析失败回退 latest）。
# 注意：注入只发生在「HTML 入口请求能到达 Worker」时。若平台默认用静态层直出
# /index.html（如 Cloudflare 的资源优先路由、EdgeOne middleware rewrite），
# 需让 / 与 /index.html 走 Worker（CF 见 wrangler.jsonc 的 run_worker_first）。
#
# ⚠️ 该地址由浏览器直接加载 JS/CSS，必须同时满足两个条件，否则页面白屏：
#   1. 能返回 index.html —— 部分 npm 镜像会拦截 .html（npmmirror 的
#      registry.npmmirror.com/.../files/ 返回 451 {"error":"blocked"}）
#   2. 响应带 Access-Control-Allow-Origin —— 前端以 crossorigin 加载
#      module script / stylesheet / 字体，缺少 CORS 头会被浏览器全部拦下
#   实测：jsdelivr、unpkg 满足；npmmirror 的 registry 与 cdn 两个端点均不满足。
#
# 行为变更：旧实现是「把静态资源请求 302 重定向到 CDN」（assetsRouter 的
# /:folder/:filepath* 路由，实际取不到 filepath，且在静态层优先的平台上根本
# 不会进 Worker），现已移除，统一改为上面的 HTML 注入方式；未配置 ASSET_URLS
# 时静态资源一律由源站提供。
#
# 例：
#   https://cdn.jsdelivr.net/npm/@openlist-frontend/openlist-frontend@$version/dist
#   https://unpkg.com/@openlist-frontend/openlist-frontend@$version/dist
ASSET_URLS=

# MySQL 连接串（DB_DRIVER=mysql 时必填），如 mysql://user:pass@host:3306/db
# 也可改用 wrangler.jsonc 中注释的 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASS / MYSQL_NAME 分项。
MYSQL_URLS=

# EdgeOne Node 云函数专用：KV 代理地址（DB_DRIVER=kv 且运行在 EdgeOne Node 云函数时必填）。
# EdgeOne 的 KV 绑定不会注入 Node 云函数，必须经同部署的 Edge Functions 代理访问，
# 此处填写部署的 origin，如 https://your-project.edgeone.app
# 留空时自动使用当前请求的 origin（同一部署自调用）；跨域或本地调试才需显式设置。
EO_KV_URLS=

# Cloudflare KV REST API 凭据（DB_DRIVER=cfkv 时三项均必填）。
# 账户 ID
CF_ACCOUNT=
# KV namespace ID
CF_KV_UUID=
# 具有 KV 读写权限的 API Token
CF_API_KEY=
