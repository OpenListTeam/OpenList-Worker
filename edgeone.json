{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/d/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/sd/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ]
}
